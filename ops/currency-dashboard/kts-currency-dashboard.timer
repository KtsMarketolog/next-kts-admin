[Unit]
Description=Refresh KTS currencies every 5 minutes, including 08:30 Moscow

[Timer]
OnCalendar=*-*-* *:00/5:00 Europe/Moscow
AccuracySec=1s
RandomizedDelaySec=0
# A late startup must not masquerade as the missed 08:30 observation.
Persistent=false
Unit=kts-currency-dashboard.service

[Install]
WantedBy=timers.target
