[Unit]
Description=KTS isolated restore of downloaded cloud backup
OnFailure=kts-backup-alert@%n.service

[Service]
Type=oneshot
ExecStart=/home/kts/.local/lib/kts-backup/run.sh restore-downloaded
UMask=0077
MemoryHigh=768M
MemoryMax=1G
CPUQuota=100%
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
# Cloud fetch is a separate service. PostgreSQL and its restore cannot use IP sockets.
RestrictAddressFamilies=AF_UNIX
PrivateTmp=true
TimeoutStartSec=45min
TimeoutStopSec=60
KillMode=mixed
StandardOutput=journal
StandardError=journal
