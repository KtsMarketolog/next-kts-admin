SITE_URL=https://kts-impex.ru
YANDEX_SITE_VERIFICATION=

# Dashboard snapshots are uploaded manually in the admin dashboard.
# Legacy MANAGER_DASHBOARD_MAIL_* values are ignored; no dashboard mail credentials are needed.

# Employee password display copies are encrypted on the server and bound to the login hash.
# By default their key is derived (HKDF, separate purpose) from the existing stable
# ADMIN_SESSION_SECRET (at least 32 bytes in production). Keep that secret across deploys
# and in secure backups: changing it makes old display copies unreadable, NOT login hashes.
# Optional separate key: exactly 32 random bytes encoded as base64. Never NEXT_PUBLIC_*.
# EMPLOYEE_PASSWORD_ENCRYPTION_KEY=
# Do not rotate/remove a key without re-encrypting its copies first. Enabling a dedicated
# key preserves reads of existing session-secret copies while both secrets are retained.
